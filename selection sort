// to arrange element in assneding order or selection sort
import java.util.*;
public class Main{
    public static void main(String args[]){
        int []arr={5,6,2,3,1,8,4};
        int n=arr.length;
        for(int i=0;i<n;i++){
        int minIndex=i;
        for(int j=i+1;j<n;j++){//to find minIndex
            if(arr[j]<arr[minIndex]){
                minIndex=j;
            }
        }//end of it
        int temp=arr[i];
        arr[i]=arr[minIndex];
        arr[minIndex]=temp;
        }
    System.out.println(Arrays.toString(arr));
}
}
