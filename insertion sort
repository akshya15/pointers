// to arrange element insertion sort 
import java.util.*;
public class Main{
    public static void main(String args[]){
        int []arr={5,6,2,3,1,8,4};
        int n=arr.length;
        for(int i=1;i<n;i++){//i stats with 1 must
            int temp=arr[i];
            int j=i-1;
            while(j>=0 && arr[j]>temp){//j must be greater than and = to 0 so meets 1 index
                arr[j+1]=arr[j];
                j--;
            }
            arr[j+1]=temp;
        }
    System.out.println(Arrays.toString(arr));
}
}

#output:
[1, 2, 3, 4, 5, 6, 8]
